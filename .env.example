# RCC-HIROS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# ── Development (XAMPP MariaDB on this machine) ──────────────
# MySQL database connection (XAMPP MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/rcc_hiros"

# Strong random secret for JWT signing (required)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-random-secret"

# ZK Kiosk Fingerprint Service (loopback HTTP, not WebSocket)
NEXT_PUBLIC_KIOSK_SERVICE_URL="http://127.0.0.1:8765"

# ── Deployment (docker-compose.yml reads this same file) ─────
# The compose stack builds the container's DATABASE_URL from DB_PASSWORD
# and connects to its own MariaDB service — you do NOT need XAMPP running
# for the deployed stack.
#
# Required by docker-compose.yml (compose refuses to start without these):
#   DB_PASSWORD  — root password for the containerized MariaDB
#   JWT_SECRET   — reuse the value above, but make it strong/random
DB_PASSWORD="change-me-to-a-strong-database-password"
